<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BSSIDLock for Windows.
    Targets .NET Framework 4.8, which ships with Windows 10 (1903+) and Windows 11, so the result is a
    single small .exe with nothing to install. No packers, no self-extracting bundles, no obfuscation:
    plain IL that antivirus engines can read, which keeps false positives low.
    Builds on Windows, macOS or Linux with the .NET SDK (8 or later).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>BSSIDLock</AssemblyName>
    <RootNamespace>BSSIDLock</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>BSSIDLock.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Version resource (shown in Explorer > Properties > Details). Complete metadata helps reputation checks. -->
    <Version>1.4.1</Version>
    <FileVersion>1.4.1.0</FileVersion>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>BSSIDLock</Product>
    <AssemblyTitle>BSSIDLock</AssemblyTitle>
    <Description>Keep your PC connected to the Wi-Fi access point you choose.</Description>
    <Company>Behzad Fattahi</Company>
    <Authors>Behzad Fattahi</Authors>
    <Copyright>Copyright (c) 2026 Behzad Fattahi. MIT License.</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets non-Windows machines compile against .NET Framework. Build-time only; nothing ships with the app. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
